{
  "name": "@exploding-kitty/game-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --root ../.. apps/game-server/src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/persistence/migrate.ts"
  },
  "dependencies": {
    "@exploding-kitty/game-core": "0.1.0",
    "@exploding-kitty/protocol": "0.1.0",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.5.0",
    "mysql2": "^3.23.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}

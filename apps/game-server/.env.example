NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Omit all four variables for the in-memory development store. All are
# required together in production. MYSQL_ADDRESS accepts host or host:port.
MYSQL_ADDRESS=localhost:3306
MYSQL_USERNAME=exploding_kitty
MYSQL_PASSWORD=exploding_kitty
MYSQL_DATABASE=exploding_kitty
AUTH_SECRET=replace-with-at-least-32-random-characters
DEV_AUTH_ENABLED=true

# Set exactly to true only behind WeChat Cloud Run, where the gateway removes
# client values and injects X-WX-OPENID/X-WX-SOURCE. App credentials are then optional.
WECHAT_TRUST_CLOUD_HEADERS=false

# Required for direct wx.login code exchange outside trusted WeChat Cloud Run mode.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
DEADLINE_POLL_MS=1000

{
  "name": "@exploding-kitty/minigame",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:subset-font": "node scripts/subset-display-font.mjs",
    "assets:generate-sounds": "node scripts/generate-sounds.mjs",
    "assets": "npm run assets:generate-sounds && node scripts/copy-assets.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "capture:evidence": "node visual-preview/capture-evidence.mjs",
    "test:asset-quality": "node --test scripts/asset-quality.test.mjs",
    "test:visual-evidence": "node --test visual-preview/capture-evidence.test.mjs visual-preview/verify-evidence.test.mjs",
    "build": "npm run assets && node scripts/build.mjs && npm run check:assets && npm run check:bundle",
    "dev": "npm run assets && node scripts/build.mjs --watch",
    "test": "npm run test:asset-quality && npm run test:visual-evidence && vitest run --root ../.. apps/minigame/src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@exploding-kitty/presentation-model": "0.1.0",
    "@exploding-kitty/protocol": "0.1.0",
    "@exploding-kitty/session-client": "0.1.0",
    "minigame-canvas-engine": "1.0.29"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}

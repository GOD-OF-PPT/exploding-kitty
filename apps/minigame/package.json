{
  "name": "@exploding-kitty/minigame",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:subset-font": "node scripts/subset-display-font.mjs",
    "assets:generate-sounds": "node scripts/generate-sounds.mjs",
    "assets": "npm run assets:generate-sounds && node scripts/copy-assets.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "build": "npm run assets && node scripts/build.mjs --mode=production && npm run check:assets",
    "build:preview": "npm run assets && node scripts/build.mjs --mode=preview && npm run check:assets",
    "dev": "npm run assets && node scripts/build.mjs --mode=development --watch",
    "test:build-environment": "node --test scripts/build-environment.test.mjs",
    "test:runtime-config-bundle": "node --test scripts/runtime-config-bundle.test.mjs",
    "test": "npm run test:build-environment && npm run test:runtime-config-bundle && vitest run --root ../.. apps/minigame/src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@exploding-kitty/presentation-model": "0.1.0",
    "@exploding-kitty/protocol": "0.1.0",
    "@exploding-kitty/session-client": "0.1.0",
    "minigame-canvas-engine": "1.0.29"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
